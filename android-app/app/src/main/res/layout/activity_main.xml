<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== Kopfzeile: Titel + Status-Chip (klickbar) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/app_name" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/statusChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/status_not_connected"
                android:textStyle="bold" android:textSize="13sp"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="14dp" android:paddingVertical="8dp"
                android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <!-- ===== Einstellungs-Panel (einklappbar) ===== -->
        <LinearLayout android:id="@+id/settingsPanel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="10dp"
            android:background="#11888888" android:padding="12dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/language" android:textStyle="bold" />
            <Spinner android:id="@+id/languageSpinner"
                android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/connection" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/label_format" android:textSize="13sp" />
            <Spinner android:id="@+id/labelSpinner"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/device" android:textSize="13sp" />
            <Spinner android:id="@+id/deviceSpinner"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnConnect"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/connect" />
            <Button android:id="@+id/btnTest"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/test_label" style="?android:attr/buttonBarButtonStyle" />

            <!-- Ausrichtung -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/alignment" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rotation" />
                <Spinner android:id="@+id/rotateSpinner"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
                <Button android:id="@+id/btnCenterReset"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/reset" android:minWidth="0dp" android:paddingHorizontal="12dp" />
            </LinearLayout>
            <TextView android:id="@+id/offXLabel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/offset_x" android:textSize="12sp" />
            <SeekBar android:id="@+id/offXSeek"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:max="160" android:progress="80" />
            <TextView android:id="@+id/offYLabel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/offset_y" android:textSize="12sp" />
            <SeekBar android:id="@+id/offYSeek"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:max="160" android:progress="80" />

            <!-- KI-Key (einmalig) -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/ai" android:textStyle="bold" />
            <EditText android:id="@+id/aiKeyInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/ai_key_hint" android:inputType="textPassword" />
        </LinearLayout>

        <!-- ===== Druckvorschau ===== -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="@string/preview" android:textStyle="bold" />
        <ImageView android:id="@+id/imagePreview"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:adjustViewBounds="true"
            android:maxHeight="300dp" android:minHeight="110dp" android:scaleType="fitCenter"
            android:background="#11888888" />
        <Button android:id="@+id/btnPrint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/print" android:textStyle="bold" android:textSize="17sp" />
        <TextView android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/status_initial" android:textSize="13sp" />

        <!-- ===== Tabs ===== -->
        <com.google.android.material.tabs.TabLayout android:id="@+id/tabLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:tabMode="scrollable">
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_text" />
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_image" />
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_code" />
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_ai" />
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_gallery" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Tab-Inhalte -->
        <LinearLayout android:id="@+id/panelText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="10dp">
            <EditText android:id="@+id/textInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/text_hint" android:inputType="textMultiLine" android:minLines="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <Spinner android:id="@+id/textSizeSpinner" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <Spinner android:id="@+id/textAlignSpinner" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            </LinearLayout>
            <Button android:id="@+id/btnBuildText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/text_to_preview" />
        </LinearLayout>

        <LinearLayout android:id="@+id/panelImage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="10dp" android:visibility="gone">
            <CheckBox android:id="@+id/chkDither"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:checked="true" android:text="@string/dithering" />
            <Button android:id="@+id/btnPickImage"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/image_to_preview" />
        </LinearLayout>

        <LinearLayout android:id="@+id/panelCode"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="10dp" android:visibility="gone">
            <EditText android:id="@+id/codeInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/code_hint" android:inputType="text" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <Button android:id="@+id/btnBuildQr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/qr_to_preview" />
                <Button android:id="@+id/btnBuildBarcode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/barcode_to_preview" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/panelAi"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="10dp" android:visibility="gone">
            <EditText android:id="@+id/aiPromptInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:hint="@string/ai_prompt_hint" android:inputType="text" />
            <Button android:id="@+id/btnAiGenerate"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/generate_to_preview" />
        </LinearLayout>

        <LinearLayout android:id="@+id/panelGallery"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="10dp" android:visibility="gone">
            <TextView android:id="@+id/galleryHint"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/gallery_hint"
                android:textSize="13sp" />
            <GridLayout android:id="@+id/gridGallery"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:columnCount="3" android:layout_marginTop="6dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
